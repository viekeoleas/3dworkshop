    {
      "type": "panel",
      "name": "Передняя стенка",
      "size": [
        ["-", "width", ["*", 2, "wall"]],
        ["-", "height", "bottom"],
        "wall"
      ],
      "origin": ["wall", "bottom", ["-", "depth", "wall"]],
      "holes": [
        {
          "x": ["-", ["/", "width", 2], "wall"],
          "y": ["-", ["/", "height", 2], "bottom"],
          "radius": ["/", "diameter", 2]
        }
      ]
    }
